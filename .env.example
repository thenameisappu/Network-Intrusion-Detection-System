# ── Flask ─────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# ── MongoDB ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=nids_db

# ── File uploads ──────────────────────────────────────
UPLOAD_FOLDER=dataset/uploads
MAX_UPLOAD_SIZE_MB=100

# ── ML artifacts ──────────────────────────────────────
MODEL_PATH=models

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
